# --- Innlogging (Auth.js + Google) ---
# Lag med: npx auth secret   (eller: openssl rand -base64 33)
AUTH_SECRET=
# Offentlig adresse til appen, f.eks. https://hallaien.example.no
AUTH_URL=http://localhost:3000
# OAuth-klient fra Google Cloud Console (APIs & Services > Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Workspace-domener som gir tilgang (kommaseparert)
TEACHER_DOMAINS=vlfk.no
STUDENT_DOMAINS=iskule.no
# Kun lokalt: logg inn uten Google ved å skrive en e-postadresse. Virker aldri i produksjon.
# AUTH_DEV_LOGIN=true

# --- Google Cloud ---
GOOGLE_CLOUD_PROJECT=
# Sti til nøkkelfilen (JSON) for tjenestekontoen. Brukes av både Firestore og Vertex AI.
GOOGLE_APPLICATION_CREDENTIALS=/sti/til/service-account.json
# Kun hvis Firestore-databasen ikke heter (default)
# FIRESTORE_DATABASE_ID=
# Kun lokalt mot Firestore-emulatoren
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# --- Tale (Gemini Live) ---
# Produksjon: Vertex AI i EU, slik at lyden behandles i EU.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_LOCATION=eu
GEMINI_LIVE_MODEL=gemini-3.8-live
# Utvikling uten Vertex: sett GOOGLE_GENAI_USE_VERTEXAI=false og bruk en Gemini API-nøkkel.
# NB: API-nøkkel gir ingen garanti for at data behandles i EU.
# GEMINI_API_KEY=

# --- Server ---
PORT=3000
